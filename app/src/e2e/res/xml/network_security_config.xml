<?xml version="1.0" encoding="utf-8"?>
<!-- e2e build only: the system store plus the test CA of the local emulator stand. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/xui_e2e_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
