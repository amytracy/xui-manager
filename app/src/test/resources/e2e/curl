#!/bin/bash
out=""; url=""; probe=0
while [ $# -gt 0 ]; do
  case "$1" in -o) out="$2"; shift ;; -w) probe=1; shift ;; https://*|http://*) url="$1" ;; esac
  shift
done
echo "curl $url" >> "@STAND@/calls"
if [ "$probe" = 1 ]; then printf 2; exit 0; fi
case "$url" in
  *ipify*|*icanhazip*|*ifconfig*) echo 10.0.2.2; exit 0 ;;
  *caddyserver*) sleep 2; cp "@STAND@/caddy.tar.gz" "$out"; exit 0 ;;
  *install.sh) sleep 1; cp "@STAND@/installer.sh" "$out"; exit 0 ;;
esac
exit 0
