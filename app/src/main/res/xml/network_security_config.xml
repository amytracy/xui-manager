<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext traffic anywhere. Panel TLS uses a per-server pinned certificate set up in code,
     so no extra trust anchors are declared here. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
